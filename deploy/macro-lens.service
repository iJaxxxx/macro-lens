[Unit]
Description=MacroLens web server
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/macro-lens
ExecStart=/opt/macro-lens/macro-lens
Environment=PORT=80
Environment=STATIC_DIR=/opt/macro-lens/dist
# 允许非 root 用户监听 80 端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
